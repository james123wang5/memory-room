{
  "name": "memory-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite apps/viewer --host 127.0.0.1 --port 4317 --strictPort",
    "build": "tsc --noEmit && vite build apps/viewer --outDir ../../dist --emptyOutDir",
    "preview": "vite preview apps/viewer --outDir ../../dist --host 127.0.0.1 --port 4317 --strictPort",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:dataset": "python3 tools/run_dataset_tests.py",
    "demo:generate": "python3 tools/generate_demo.py"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.3.1",
    "fflate": "0.8.2",
    "three": "0.180.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
